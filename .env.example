# ==============================================================================
# SIH 26090: Environment Variables Template
# Copy this file to .env and configure with safe environment-specific values.
# DO NOT commit real secrets, API keys, or production passwords to version control.
# ==============================================================================

# Application Environment
APP_ENV=development                       # Options: development, staging, production
APP_NAME="SIH 26090 Artisan Market Linkage"
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO                           # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Security & Session
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-for-local-dev
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16+ with pgvector)
# For local development with PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/artisan_linkage
# Fallback SQLite URL for local offline testing:
# DATABASE_URL=sqlite+aiosqlite:///./artisan_linkage.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=3600

# CORS Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Object Storage Configuration (S3-Compatible / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=minio                   # Options: minio, r2, s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BUCKET_NAME=artisan-media-public
S3_PRIVATE_BUCKET_NAME=artisan-documents-private
S3_REGION=us-east-1
S3_PUBLIC_CDN_URL=http://localhost:9000/artisan-media-public

# AI Provider Configuration Placeholders (Do not insert real keys here)
AI_VISION_PROVIDER=gemini                # Options: gemini, mock, none
AI_VISION_MODEL=gemini-1.5-flash        # Vision model name
AI_VISION_TIMEOUT_SECONDS=30             # Timeout in seconds
AI_PROMPT_VERSION=product_vision_v1      # Versioned prompt identifier
AI_VOICE_PROVIDER=whisper                # Options: whisper, bhashini
GEMINI_API_KEY=your-gemini-api-key-here
BHASHINI_API_KEY=your-bhashini-api-key-here
AI_EMBEDDING_PROVIDER=gemini             # Options: gemini, mock, none
AI_EMBEDDING_MODEL=gemini-embedding-2    # Active Gemini embedding model (output_dimensionality=768)
EMBEDDING_DIMENSION=768                   # 768-dimensional normalized dense vectors
AI_MATCHING_ENGINE_VERSION=MATCHING_ENGINE_V1

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60
